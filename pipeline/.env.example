# Copy to .env and fill in what you have. .env is gitignored — never commit it.
# Run `python run.py keys` to see status and live-probe each credential.
#
# Nothing here is required to run the pipeline as it stands today: cBioPortal
# and ClinicalTrials.gov need no credentials. These unlock additional sources.

# --- NCI SEER --- NOT REQUIRED ---------------------------------------------
# The SEER API is restricted to government-authorised users, so most people
# cannot get an account. We do not depend on it.
#
# Subtype incidence and 5-year survival come from the PUBLISHED tables at
#   https://seer.cancer.gov/statfacts/html/breast-subtypes.html
# which are open and machine-readable. See cxp/seer.py; `run.py incidence`
# works with no credentials at all.
#
# Set this only if you already have SEER access and want custom API queries.
# Sent as: X-SEERAPI-Key header. Limit 5,000 calls/hour.
SEER_API_KEY=

# --- NCBI E-utilities (optional) -------------------------------------------
# Works without a key at 3 req/sec; a key raises it to 10 req/sec.
# Get it:  https://www.ncbi.nlm.nih.gov/account/ -> Settings -> API Key Management
# Sent as: api_key query parameter
# Note:    one key per account; generating a new one invalidates the old
NCBI_API_KEY=

# --- openFDA (optional) ----------------------------------------------------
# Works without a key at 1,000 req/day; a key raises it to 120,000/day.
# Get it:  https://open.fda.gov/apis/authentication/
# Sent as: api_key query parameter
OPENFDA_API_KEY=

# --- OncoKB (licence required) ---------------------------------------------
# Unlocks: curated therapeutic actionability levels.
# UNVERIFIED — oncokb.org is a JS app that the docs fetcher could not render,
# so confirm the current terms yourself. Free for academic/non-commercial use;
# commercial use requires a licence.
# Get it:  https://www.oncokb.org/account/register
# Sent as: Authorization: Bearer <token>
ONCOKB_TOKEN=
